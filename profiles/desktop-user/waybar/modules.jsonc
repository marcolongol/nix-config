{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox>": "",
      "class<zen-beta>": "",
      "class<zen>": "",
      "class<(.*)Chromium(.*)>": "",
      "class<(.*)thunar(.*)>": "",
      "class<(.*)nautilus(.*)>": "",
      "class<(.*)obs(.*)>": "",
      "class<(.*)spotify(.*)>": "",
      "class<(.*)discord(.*)>": "",
      "class<(.*)Code(.*)>": "󰨞",
      "class<code>": "󰨞",
      "class<(.*)cursor(.*)>": "󰨞",
      "class<(.*)docker(.*)>": "",
      "class<(.*)ghostty(.*)>": "",
      "class<(.*)alacritty(.*)>": "",
      "class<(.*)kitty(.*)>": "",
      "class<(.*)thunderbird(.*)>": "",
      "class<(.*)slack(.*)>": "",
      "class<(.*)Signal(.*)>": "",
      "class<(.*)telegram(.*)>": "",
      "class<(.*)vlc(.*)>": "󰕼",
      "class<(.*)mpv(.*)>": "",
      "class<(.*)Steam(.*)>": "",
      "class<(.*)pavucontrol(.*)>": "",
      "class<(.*)blueman(.*)>": "",
      "class<(.*)Anytype(.*)>": "",
      "class<(.*)remmina(.*)>": "",
      "class<(.*)Remmina(.*)>": "",
      "class<(.*)teams(.*)>": "",
      "class<(.*)Teams(.*)>": "",
      "class<(.*)zoom(.*)>": "",
      "class<(.*)Zoom(.*)>": "",
      "class<(.*)obsidian(.*)>": "",
      "class<(.*)Obsidian(.*)>": "",
      "class<(.*)jetbrains(.*)>": "",
      "class<(.*)IntelliJ(.*)>": "",
      "class<(.*)PyCharm(.*)>": "",
      "class<(.*)GoLand(.*)>": "",
      "class<(.*)WebStorm(.*)>": "",
      "class<(.*)libreoffice(.*)>": "",
      "class<(.*)Bitwarden(.*)>": "",
      "class<(.*)bitwarden(.*)>": "",
      "class<(.*)Element(.*)>": "",
      "class<(.*)element(.*)>": "",
      "class<(.*)1Password(.*)>": "",
      "title<.*github.*>": "",
      "title<.*youtube.*>": ""
    },
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    }
  },
  "hyprland/window": {
    "format": "{initialClass}",
    "icon": true,
    "icon-size": 19,
    "separate-outputs": true,
    "rewrite": {
      "Mozilla Firefox": "Firefox",
      "zen-beta": "Zen Browser",
      "(.*) Thunar": "Thunar",
      "(.*)obs(.*)": "OBS",
      "Spotify (.*)": "Spotify",
      "discord(.*)": "Discord",
      "Code": "VS Code",
      "Docker Desktop": "Docker",
      "com.mitchellh.ghostty": "Ghostty"
    }
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-len": 32,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "interval": 1,
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "zen": "",
      "mpv": "",
      "vlc": "󰕼"
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "ignored-players": [
      "firefox",
      "chromium",
      "Chromium"
    ],
    "tooltip-format": "{player}: {title}\n{artist} — {album}\n\nLeft: play/pause  Right: next  Mid: prev\nScroll: prev/next track",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "cpu": {
    "interval": 2,
    "format": "<span color='#f4c79a'></span>  {usage}%",
    "max-length": 12,
    "states": {
      "good": 50,
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 30,
    "format": "<span color='#c5a3f0'></span>  {}%",
    "max-length": 12,
    "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "on-click": "ghostty -e btop"
  },
  "disk": {
    "format": "<span color='#90e0a3'></span>  {percentage_used}%",
    "states": {
      "mounted": 0,
      "warning": 70,
      "critical": 90
    },
    "path": "/persist"
  },
  "temperature": {
    "interval": 3,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": "<span color='#a3c5f0'></span>  {temperatureC}°C",
    "format-critical": "<span color='#f5a3a3'></span>  {temperatureC}°C",
    "tooltip-format": "CPU Temperature: {temperatureC}°C\nCritical threshold: 80°C\nClick to open btop",
    "states": {
      "good": 60,
      "warning": 70,
      "critical": 80
    },
    "on-click": "ghostty -e btop"
  },
  "custom/gpu-temp": {
    "interval": 3,
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo 'N/A'",
    "format": "<span color='#d9a3c5'></span>  {}°C",
    "tooltip": true,
    "tooltip-format": "NVIDIA RTX 4060 GPU Temperature: {}°C\nClick to open nvidia-smi",
    "on-click": "ghostty -e nvidia-smi -l 1"
  },
  "custom/weather": {
    "interval": 1800,
    "exec": "curl -s --max-time 5 'https://wttr.in/?format=%c+%t' 2>/dev/null | sed 's/+//g' || echo '󰼯'",
    "return-type": "",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather (wttr.in)\nClick: full forecast",
    "on-click": "ghostty -e sh -c 'curl https://wttr.in; read'"
  },
  "clock": {
    "interval": 1,
    "format": "  {:%H:%M %Z / %h %d}",
    "format-alt": "{:%A, %B %d, %Y (%R) %Z}",
    "timezones": [
      "America/New_York",
      "America/Los_Angeles",
      "Europe/Berlin",
      "Asia/Kolkata"
    ],
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-icons": [
      "󰢼",
      "󰢼",
      "󰢽",
      "󰢽",
      "󰢾"
    ],
    "format-disconnected": "󰞃",
    "interval": 5,
    "tooltip-format-wifi": " {bandwidthDownBytes} |  {bandwidthUpBytes} | {essid}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.local/bin/rofi-wifi.py"
  },
  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": " {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-ethernet": " {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} 󰌘",
    "tooltip-format-disconnected": "󰌙 Disconnected",
    "max-length": 22,
    "min-length": 20,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected-battery": "{device_battery_percentage}% 󰂯",
    "format-alt": "{device_alias} 󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-alt": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "Notifications\nLeft: panel (Super+N)  Right: DND toggle",
    "tooltip": true
  },
  "custom/inhibit": {
    "format": "{}",
    "return-type": "json",
    "exec": "inhibit-toggle.sh status",
    "on-click": "inhibit-toggle.sh toggle",
    "signal": 11,
    "interval": "once"
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-out",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ],
    "ignore-monitor": true,
    "ignore": [
      {
        "type": "audio-in",
        "name": "cava"
      },
      {
        "type": "audio-out",
        "name": "Easy Effects Sink"
      }
    ]
  },
  // SECTION: Custom Modules
  // ------------------------
  "custom/trayicon": {
    "format": "󱄅",
    "tooltip": true,
    "tooltip-format": "Application Launcher\nClick: open rofi",
    "on-click": "rofi -show drun -show-icons"
  },
  "custom/separator": {
    "format": " // ",
    "tooltip": false
  },
  "custom/power-menu": {
    "format": "󰐥",
    "tooltip-format": "Power menu (rofi)\nSuper+X",
    "tooltip": true,
    "on-click": "rofi-power.sh"
  },
  // SECTION: Audio & Brightness Modules
  // ------------------------------------
  "wireplumber": {
    "interval": 2,
    "format": "{volume}% {icon}",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "headphone": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "hands-free": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "headset": [
        "󰋋",
        "󰋋",
        "󰋋"
      ],
      "phone": [
        "󰄜",
        "󰄜",
        "󰄜"
      ],
      "portable": [
        "󰄜",
        "󰄜",
        "󰄜"
      ],
      "car": [
        "󰄞",
        "󰄞",
        "󰄞"
      ],
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "states": {
      "muted": 0,
      "low": 30,
      "medium": 60,
      "high": 100
    },
    "scroll-step": 2.0,
    "max-volume": 150.0,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "~/.local/bin/rofi-audio-sink.sh",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Audio: {node_name}\nVolume: {volume}%\nLeft click: mute toggle\nMiddle click: pick output/input\nRight click: pavucontrol"
  },
  "backlight": {
    "interval": 2,
    "format": "{percent}% {icon}",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "states": {
      "low": 25,
      "medium": 50,
      "high": 75
    },
    "scroll-step": 5.0,
    "on-click": "brightnessctl set 50%",
    "tooltip-format": "Brightness: {percent}%\nScroll: adjust brightness\nClick: set to 50%"
  }
}
