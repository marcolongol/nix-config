{
  "layer": "top",
  "position": "top",
  "name": "nixbar",
  "height": "32px",
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "group/tray",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "hyprland/window",
    "mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "privacy",
    "custom/weather",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "custom/gpu-temp",
    "network#speed",
    "custom/separator",
    "wireplumber",
    "backlight",
    "bluetooth",
    "network",
    "custom/inhibit",
    "battery",
    "custom/separator",
    "custom/power-menu"
  ],
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  // SECTION: Groups
  // -----------------
  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/trayicon",
      "tray"
    ]
  },
  "custom/power-menu": {
    "format": "",
    "tooltip-format": "Power menu (rofi)\nSuper+X",
    "tooltip": true,
    "on-click": "rofi-power.sh"
  }
}
