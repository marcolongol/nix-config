{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "automerge": false,
  "platformAutomerge": false,

  "nix": {
    "enabled": true
  },

  "lockFileMaintenance": {
    "enabled": true,
    // Bumps every input at once, omninix included; comin deploys main, so review by hand.
    "automerge": false,
    "postUpdateOptions": ["nixFlakeUpdate"],
    "schedule": ["at any time"],
  },

  "packageRules": [
    {
      // Paused for the sharing migration (plan.md): each phase must compare
      // against its parent commit without input bumps landing in between.
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      // Both build every host via comin; review by hand.
      "matchDepNames": ["omninix", "flake-parts"],
      "automerge": false,
      "platformAutomerge": false
    }
  ],

  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "branchPrefix": "renovate/",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0
}
