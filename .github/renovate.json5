{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  // comin deploys main as root: nothing merges without review.
  "automerge": false,
  "platformAutomerge": false,

  "nix": {"enabled": true},

  // One weekly PR bumps every flake input.
  "lockFileMaintenance": {"enabled": true},

  "packageRules": [
    {
      // Per-input PRs duplicate lockFileMaintenance; omninix keeps its own.
      "matchManagers": ["nix"],
      "matchDepNames": ["!omninix"],
      "enabled": false,
    },
    {
      "matchManagers": ["github-actions", "npm", "custom.regex"],
      "minimumReleaseAge": "14 days",
    },
    {
      "matchDepNames": ["renovate"],
      "schedule": ["on the first day of the month"],
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
    },
  ],

  "customManagers": [
    {
      // Self-update the pinned Renovate version in the workflow.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.ya?ml$/"],
      "matchStrings": ["npx --yes renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
    },
  ],

  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
}
